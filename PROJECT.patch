@@ -0,0 +1,41 @@
+public class Grid {
+
+    private char[][] grid;
+
+    public Grid(int rows, int cols) {
+        grid = new char[rows][cols];
+
+        // Fill with empty spaces
+        for (int r = 0; r < rows; r++) {
+            for (int c = 0; c < cols; c++) {
+                grid[r][c] = '.';//change dot back to E if this breaks something
+            }
+        }
+    }
+
+    public char getCell(int row, int col) {
+        return grid[row][col];
+    }
+
+    public void setCell(int row, int col, char value) {
+        grid[row][col] = value;
+    }
+
+    public int getRows() {
+        return grid.length;
+    }
+
+    public int getCols() {
+        return grid[0].length;
+    }
+
+    public void display() {
+        for (char[] row : grid) {
+            for (char cell : row) {
+                System.out.print(cell + " ");
+            }
+            System.out.println();
+        }
+        System.out.println();
+    }
+}
